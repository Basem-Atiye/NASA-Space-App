{
  "name": "shackleton-station-backend",
  "private": true,
  "version": "2.0.0",
  "description": "Database schema and migrations for Shackleton Station (Supabase + Prisma), and Supabase Edge Functions.",
  "scripts": {
    "validate": "prisma validate",
    "format": "prisma format",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "catalogue": "python3 ../tools/gen_catalogue_sql.py",
    "test:db": "node test/run.mjs",
    "test:cloud": "node test/cloud-smoke.mjs",
    "functions:deploy": "supabase functions deploy --use-api --import-map supabase/functions/deno.json",
    "functions:secrets": "supabase secrets set --env-file supabase/functions/.env"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "dotenv": "^16.4.5",
    "supabase": "2.47.2"
  }
}
