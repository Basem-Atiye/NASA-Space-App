# Secrets for the Edge Functions. Set them with:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Clerk Dashboard > API keys > Secret keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional, makes token checks networkless: Clerk Dashboard > API keys > JWT public key (PEM)
CLERK_JWT_KEY=
# Clerk Dashboard > Webhooks > your endpoint > Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# https://api.nasa.gov (free). DEMO_KEY works for testing but is rate limited.
NASA_API_KEY=DEMO_KEY
# Optional: lock CORS to the teacher web dashboard origin
ALLOWED_ORIGIN=*
